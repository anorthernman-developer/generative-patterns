#!/bin/sh
# Pre-commit secret scan. Enable once per clone with:  git config core.hooksPath .githooks
if git diff --cached -U0 | grep -E '^\+' | grep -E 'AIza[0-9A-Za-z_-]{35}' >/dev/null; then
  echo "Blocked: a Google API key (AIza...) is in the staged changes. Remove it before committing." >&2; exit 1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || { echo "Blocked by gitleaks." >&2; exit 1; }
fi
exit 0
